<div class="container">
  <% if @article.errors.any? %>
    <h2>The Following Errors Prevented The Article From Being Saved:</h2>
    <ul>
        <% @article.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
        <% end %>
    </ul>
  <% end %>

  <div class="row justify-content-center">
    <div class="col-10">


  <%= form_with(model: @article, class: "bg-secondary shadow-lg p-4 rounded", local: true, data: { turbo: false }) do |f| %>

    <div class="row mb-3">
      <%= f.label :title, class: "col-2 col-form-label text-light" %>

      <div class="col-10">
        <%= f.text_field :title, class: "form-control shadow rounded", placeholder: "Enter article title" %>
      </div>
    </div>

    <div class="row mb-3">
      <%= f.label :description, class: "col-2 col-form-label text-light" %>

      <div class="col-10">
        <%= f.text_area :description, rows: 10, class: "form-control shadow rounded", placeholder: "Enter article description" %>
      </div>
    </div>

    <div class="text-center">
      <%= f.submit class: "btn btn-outline-light btn-lg" %>
    </div>

  <% end %>

  <div class="text-center mt-3">
    <%= link_to "[ Articles List ]", articles_path  %>
  </div>

</div>


  </div>
</div>
